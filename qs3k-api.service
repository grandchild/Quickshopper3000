[Unit]
Description=Quickshopper 3000 App API Server
After=network.target
Wants=network.target

[Service]
User=http
Group=http
WorkingDirectory=/mnt/vol01/websites/effekthasch.org/qs3k/
Environment=QS3K_PUBLIC_URL=https://effekthasch.org/qs3k-api
ExecStart=/mnt/vol01/websites/effekthasch.org/qs3k/qs3k-api
Restart=always

[Install]
WantedBy=multi-user.target
